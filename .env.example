PORT=3000
# Local development can use 127.0.0.1. Production web services usually need 0.0.0.0.
HOST=127.0.0.1
SESSION_SECRET=replace-this-with-a-long-random-secret
BASE_URL=http://localhost:3000

# Optional. Use Supabase/PostgreSQL instead of server/data/store.json.
DATABASE_URL=
DATABASE_SSL=true

# Optional. Add a Stripe test secret key to turn demo checkout into hosted Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
